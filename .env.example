# daily.dev Personal Access Token (server only, never NEXT_PUBLIC_)
# Create at https://daily.dev/settings/api and set the real value in .env.local.
DAILY_DEV_TOKEN=

# Production only: enable AFTER protecting this personal dashboard/API with
# owner authentication or an authenticated reverse proxy. Not needed in dev.
DAILY_DEV_FEED_ENABLED=false

# Supabase backend rollout P01
# Keep existing .env.local entries; generate .env.development.local via backend:local:env.
# Supabase values here are placeholders and must fail validation.
# Keep APP_ENV=local for this machine. See docs/backend-rollout/LOCAL_DEVELOPMENT.md.
APP_ENV=local
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Cloud settings belong ONLY in the matching environment, never a fallback.
# APP_ENV=production or preview; SUPABASE_PROJECT_REF=replace-with-project-ref
# Preview requires a separate dev project and must not use production credentials.
# APP_OWNER_USER_ID=replace-after-P03-bootstrap
# GITHUB_OWNER_ID=replace-after-P03-verified-provider-identity

# Only for local Supabase CLI when enabling GitHub in P03; never NEXT_PUBLIC_.
# SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=replace-with-local-oauth-client-id
# SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=replace-in-private-env-only
# Runtime CRUD must never use a service-role/secret admin key or DATABASE_URL.
