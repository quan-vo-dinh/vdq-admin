{
  "name": "main",
  "description": "ShadcnDashboard Modern Next.js Admin Dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:calendar": "node scripts/test-calendar.mjs",
    "test:learning": "node scripts/test-learning.mjs",
    "test:finance": "node scripts/test-finance.mjs",
    "test:developer": "node scripts/test-developer.mjs",
    "test:notes": "node scripts/test-notes.mjs",
    "test:notes:api": "node scripts/test-notes-api.mjs",
    "test:today": "node scripts/test-today.mjs",
    "test:backend-setup": "node --test scripts/backend/*.test.mjs scripts/data/*.test.mjs",
    "backend:env:check": "node scripts/backend/check-env.mjs",
    "backend:local:env": "node scripts/backend/local-env.mjs",
    "backend:types": "node scripts/backend/generate-types.mjs",
    "backend:local:start": "node --env-file-if-exists=.env.supabase.local scripts/backend/local-stack.mjs",
    "backend:local:stop": "supabase stop",
    "backend:local:reset": "node scripts/backend/reset-local.mjs",
    "backend:local:smoke": "node scripts/backend/local-smoke.mjs",
    "backend:cloud:smoke": "node --env-file=.env.cloud-tooling.local scripts/backend/cloud-smoke.mjs",
    "backend:backup": "node scripts/backend/backup.mjs --mode backup",
    "backend:backup:verify": "node scripts/backend/backup.mjs --mode verify",
    "backend:restore:drill": "node scripts/backend/backup.mjs --mode restore --workdir /tmp/dashboard-p09-drill",
    "mobile:dev": "vite --config mobile/vite.config.ts",
    "mobile:typecheck": "tsc --project mobile/tsconfig.json",
    "mobile:build": "pnpm mobile:typecheck && vite build --config mobile/vite.config.ts",
    "mobile:sync": "pnpm mobile:build && cap sync android",
    "android:debug": "pnpm mobile:sync && node scripts/mobile/android-build.mjs debug",
    "android:release": "pnpm mobile:sync && node scripts/mobile/android-build.mjs release",
    "test:mobile-contracts": "node --test scripts/mobile/*.test.mjs",
    "mobile:scan": "node scripts/mobile/scan.mjs",
    "mobile:build:local": "pnpm mobile:typecheck && vite build --config mobile/vite.config.ts --mode development",
    "mobile:sync:local": "pnpm mobile:build:local && cap sync android",
    "android:unsigned": "pnpm mobile:sync && node scripts/mobile/android-build.mjs unsigned",
    "test:mobile-api": "node scripts/mobile/test-api-local.mjs",
    "mobile:preview:build": "pnpm mobile:typecheck && vite build --config mobile/vite.config.ts --mode development --outDir preview",
    "mobile:preview": "vite preview --config mobile/vite.config.ts --mode development --outDir preview --host localhost --port 5173 --strictPort",
    "test:portfolio": "node --test scripts/backend/portfolio-model.test.mjs && node scripts/backend/test-portfolio-local.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/geist": "5.3.0",
    "@iconify/react": "6.0.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-bullet-list": "^3.22.3",
    "@tiptap/extension-code-block-lowlight": "^3.22.3",
    "@tiptap/extension-image": "^3.22.3",
    "@tiptap/extension-link": "^3.22.3",
    "@tiptap/extension-list": "^3.22.3",
    "@tiptap/extension-list-item": "^3.22.3",
    "@tiptap/extension-ordered-list": "^3.22.3",
    "@tiptap/extension-underline": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "chance": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "input-otp": "^1.4.2",
    "lodash": "^4.18.1",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "react": "19.2.5",
    "react-activity-calendar": "^3.2.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.5",
    "react-dropzone": "^15.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.3.0",
    "sharp": "^0.35.5",
    "simplebar-react": "3.3.2",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/postcss": "^4",
    "@types/chance": "^1.1.7",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "supabase": "2.121.0",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.23.2 <23"
  }
}
